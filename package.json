{
  "name": "lifiweb",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:firestore": "node scripts/audit-firestore.mjs",
    "qa:security": "node scripts/test-public-write.mjs",
