# Supabase: destino de datos.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY es pública y puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Solo servidor / scripts de migración. NUNCA usar NEXT_PUBLIC_ ni EXPO_PUBLIC_.
# No guardes el valor real en Git; configúralo en tu entorno seguro.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Firebase se conserva temporalmente como fuente de migración y respaldo hasta
# verificar que Supabase contiene todos los IDs actuales. Esta configuración de
# cliente es pública; no contiene credenciales administrativas.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBLGMtJ6QJSNwakmD_PdgtstARICyu1sEI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lifiwebapp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lifiwebapp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lifiwebapp.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=798436972351
NEXT_PUBLIC_FIREBASE_APP_ID=1:798436972351:web:7242cbd43e3fb46c99a58a
NEXT_PUBLIC_FIREBASE_ARTIFACT_ID=lifi-2026-prod

# La app Expo sigue usando Firebase durante el período de migración.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBLGMtJ6QJSNwakmD_PdgtstARICyu1sEI
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lifiwebapp.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lifiwebapp
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=lifiwebapp.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=798436972351
EXPO_PUBLIC_FIREBASE_APP_ID=1:798436972351:web:7242cbd43e3fb46c99a58a
EXPO_PUBLIC_FIREBASE_ARTIFACT_ID=lifi-2026-prod

# URL pública usada por metadata, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
